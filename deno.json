{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-run --allow-sys --env-file main.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-run --allow-sys --env-file main.ts",

    "check": "deno check main.ts",
    "test": "deno test --allow-net --allow-env --allow-read",
    "indexes": "deno run --allow-net --allow-env --allow-read --env-file scripts/ensure-indexes.ts",
    "verify:firestore": "deno run --allow-net --allow-env --allow-read --env-file scripts/verify-firestore.ts",
    "verify:scrape": "deno run --allow-net --allow-env --allow-read --allow-run --allow-sys --env-file scripts/verify-scrape.ts",
    "verify:gaceta": "deno run --allow-net --allow-env --allow-read --allow-run --allow-sys --env-file scripts/verify-gaceta.ts",


    "verify:validator": "deno run --allow-net --allow-env --allow-read --env-file scripts/verify-validator.ts",
    "verify:api": "deno run --allow-net --allow-env --allow-read --env-file scripts/verify-api.ts",
    "verify:moderation": "deno run --allow-env --allow-read --env-file scripts/verify-moderation.ts",
    "pipeline": "deno run --allow-net --allow-env --allow-read --allow-run --allow-sys --env-file scripts/run-pipeline.ts",
    "publish": "deno run --allow-net --allow-env --allow-read --env-file scripts/publish.ts"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4.6.14",
    "hono/http-exception": "jsr:@hono/hono@^4.6.14/http-exception",
    "hono/factory": "jsr:@hono/hono@^4.6.14/factory",
    "hono/jwt": "jsr:@hono/hono@^4.6.14/jwt",
    "@std/assert": "jsr:@std/assert@^1.0.9",
    "@std/dotenv/load": "jsr:@std/dotenv@^0.225.2/load",

    "nodemailer": "npm:nodemailer@^6.9.16",
    "selenium-webdriver": "npm:selenium-webdriver@^4.27.0",
    "selenium-webdriver/chrome": "npm:selenium-webdriver@^4.27.0/chrome.js"
  },

  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any", "require-await"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false
  }
}
