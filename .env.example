# Copy to .env and fill in. Real environment variables always win over this file.

# Required. Signs session tokens. Generate one with:
#   deno eval "console.log(crypto.randomUUID() + crypto.randomUUID())"
JWT_SECRET=

# Where the API listens, and where the site it serves lives.
PORT=8010
APP_BASE_URL=http://localhost:3002
APP_NAME=El Censo

# Firestore. The service account JSON is read from disk and never committed.
SERVICE_ACCOUNT_PATH=./service-account.json
FIRESTORE_DATABASE=(default)

# Gmail or Google Workspace sender for login codes. Use an App Password, not the
# account password. Leave both blank in development and codes print to the console.
APP_GMAIL_USER=
APP_GMAIL_PASS=

# The first address allowed to grant editor access. Everyone else starts as a
# voter until this account promotes them.
SEED_ADMIN_EMAIL=

# Login codes and sessions.
OTP_TTL_MINUTES=10
SESSION_TTL_DAYS=7

# The scrape and agent pipeline. Off by default: it drives a real browser and
# needs a signed-in Chrome profile on the host.
PIPELINE_ENABLED=false
SCRAPE_INTERVAL_MINUTES=30

# ── The law catalogue ────────────────────────────────────────────────────────
# Reads ConsultaLeyes.aspx on a timer inside this process, so it only runs where
# the server runs continuously. On a host that sleeps an idle container or
# recycles it between requests, the timer dies with the process: point an
# external scheduler at the sweep instead of relying on this switch.
#
# Off by default. Turning it on starts the historical descent, which will walk
# down the whole numbering over several days before settling into checking only
# for newly published laws.
LAWS_ENABLED=false

# How often the crawler wakes up.
LAW_INTERVAL_MINUTES=60

# Law numbers catalogued per tick while descending through history. Each one is
# about three requests to the Asamblea, so this is a courtesy limit as much as a
# cost one. Raising it will finish the backfill sooner and lean harder on a
# public service.
LAW_SEED_BATCH=25

# Laws summarised per tick. Much smaller than the seed batch because this is the
# expensive half: cataloguing is three cheap requests, summarising runs the
# model over the full text of a law.
LAW_SUMMARY_BATCH=3

# Laws below this number are catalogued but not summarised in advance; they get
# their summary the first time somebody opens one. Keeps the backfill from
# spending thousands of model calls on decades of laws nobody will read. Set to
# 0 to summarise everything.
LAW_SUMMARY_FLOOR=10466

# How far above the highest known law to keep probing for newly published ones.
# A number can be reserved slightly before its record appears, so this has to be
# greater than zero or the catalogue would freeze at the first gap.
LAW_CEILING_SCAN_LIMIT=25

# Pause between requests to the Asamblea. Do not set this to zero.
LAW_REQUEST_DELAY_MS=750

# How long to wait for one request. From inside Costa Rica the SIL answers in
# about a second, so a longer wait buys nothing — it only decides how long an
# unreachable host takes to admit it.
LAW_REQUEST_TIMEOUT_MS=20000

# ── If the server is hosted outside Costa Rica ───────────────────────────────
# consultassil3.asamblea.go.cr (196.40.23.181) answers Costa Rican networks and
# silently drops everything else. From abroad the connection is not refused, it
# hangs, so every request ends in a timeout and the catalogue never advances.
#
# Verified: from Costa Rica it connects in 0.24s; from two separate US hosts it
# times out. Nothing in this codebase can work around that — the packets do not
# arrive. The server needs an egress inside the country.
#
# This cannot be faked with headers. Tested: X-Forwarded-For and CF-IPCountry
# claiming to be Costa Rican, sent from a US host, still fail; the same request
# from Costa Rica returns 200. The filtering happens on the connection, before
# any header is read, so the proxy has to be a machine that genuinely sits on a
# Costa Rican network. There is no value here that works by pretending.
#
# Set it to an HTTP/HTTPS proxy inside Costa Rica and the crawler will use it
# for the Asamblea only. Blank means connect directly, which is correct when the
# server itself runs in Costa Rica.
#
#   LAW_HTTP_PROXY=http://user:pass@proxy-cr.example.com:8080
#
# Check any candidate before deploying it — this must print 200:
#
#   curl -x "$LAW_HTTP_PROXY" -s -o /dev/null -w "%{http_code}\n" \
#     https://consultassil3.asamblea.go.cr/frmConsultaLey.aspx
LAW_HTTP_PROXY=



# How much the pipeline narrates as it works.
#
#   quiet    only failures
#   normal   one line per transformation: sizes, counts, timings, and a warning
#            when a value the SIL printed could not be converted. Safe to leave
#            on in production; this is the default.
#   verbose  the values themselves — dates before and after parsing, the start
#            of the extracted text, every field the model wrote. Use it to find
#            out why one specific law came out wrong, then turn it back down:
#            it prints law text and model output on every law it touches.
LAW_LOG_LEVEL=normal

# Lets an external scheduler run one sweep over HTTP, for hosts where the

# in-process timer above will not survive. Blank keeps the route closed and
# returning 404. When set, call it as:
#
#   curl -X POST https://api.example.com/api/laws/sweep \
#        -H "Authorization: Bearer $LAW_SWEEP_TOKEN"
#
# Generate one with:
#   deno eval "console.log(crypto.randomUUID() + crypto.randomUUID())"
LAW_SWEEP_TOKEN=




# ── Daily spending limits ────────────────────────────────────────────────────
# Ceilings on the three things that cost money or goodwill: Firestore reads and
# writes, model calls, and requests to the Asamblea. Reaching one pauses the
# crawler until midnight; it never blocks a reader, because readers are served
# from a reservation the background work is not allowed to touch.
#
# Counters live in .budget.json next to the process and reset on the first
# activity after midnight, Costa Rica time. Delete that file to reset by hand.

# Firestore operations per day. The free tier is 50k reads and 20k writes a day;
# reads and writes are counted together here against one number, deliberately
# far below the smaller of the two so a miscount still lands inside the tier.
# Half of this is the most the crawler may take; the rest is held for readers.
BUDGET_FIRESTORE_PER_DAY=30000

# Model calls per day. One call is one law read and explained, so this reads as
# "laws explained today" and is the line that shows up on an invoice.
BUDGET_MODEL_PER_DAY=200

# HTTP requests to the Asamblea per day. Not about money but about courtesy: it
# is a public institution's server and the crawler is the only thing that goes
# there, so all of this is the crawler's to spend — slowly. The pace between
# requests is LAW_REQUEST_DELAY_MS above, enforced by the limiter itself.
BUDGET_ASAMBLEA_PER_DAY=3000

# Where the day's counters are kept. They must outlive a restart: a process that
# forgets what it spent would, in a crash loop, replay the last slice of the
# quota over and over. Delete this file to reset the day by hand.
#
# On a host with an ephemeral filesystem this resets on every deploy, which is
# the safe direction to be wrong in — it over-counts nothing, it merely forgets.
BUDGET_STATE_PATH=./.budget.json
